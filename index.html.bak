            </div>
        </section>

        <!-- Video Section -->
        <section class="relative w-full h-screen overflow-hidden reveal-section" id="video-section">
            <video id="scrollVideo" class="absolute top-0 left-0 w-full h-full object-cover" autoplay muted playsinline loop>
