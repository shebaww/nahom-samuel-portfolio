            <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2">
                <span class="font-label text-[8px] uppercase tracking-[0.3em] text-primary/60">scroll to continue</span>
                <div class="w-px h-12 bg-gradient-to-b from-primary to-transparent"></div>
            </div>
        </section>

<!-- Philosophy Section - Detailed Polaroids -->
<section class="py-24 md:py-40 px-6 md:px-12 bg-background reveal-section relative overflow-hidden min-h-screen" id="philosophy">
    
    <!-- Polaroid 1 - Top Left -->
    <div class="absolute top-4 left-4 md:top-12 md:left-12 w-40 md:w-56 rotate-[-15deg] transition-all duration-500 hover:rotate-0 hover:scale-110 hover:shadow-2xl hover:z-50 group cursor-pointer" style="z-index: 10;">
        <div class="bg-white p-2 pb-8 md:p-3 md:pb-12 shadow-xl rounded-sm">
            <img src="https://picsum.photos/id/15/400/400" alt="Mountain adventure" class="w-full h-32 md:h-48 object-cover grayscale group-hover:grayscale-0 transition-all duration-500">
            <div class="mt-3 md:mt-4 px-2">
                <p class="font-headline italic text-xs md:text-sm text-gray-800">Adventurous</p>
                <p class="font-body text-[8px] md:text-[10px] text-gray-500 mt-1">"The mountains are calling..."</p>
                <div class="mt-2 h-px w-full bg-gray-200"></div>
                <p class="font-label text-[6px] md:text-[8px] uppercase tracking-wider text-primary mt-2">#wanderlust</p>
            </div>
        </div>
    </div>

    <!-- Polaroid 2 - Top Right -->
    <div class="absolute top-4 right-4 md:top-12 md:right-12 w-40 md:w-56 rotate-[10deg] transition-all duration-500 hover:rotate-0 hover:scale-110 hover:shadow-2xl hover:z-50 group cursor-pointer" style="z-index: 10;">
        <div class="bg-white p-2 pb-8 md:p-3 md:pb-12 shadow-xl rounded-sm">
            <img src="https://picsum.photos/id/96/400/400" alt="Night sky" class="w-full h-32 md:h-48 object-cover grayscale group-hover:grayscale-0 transition-all duration-500">
            <div class="mt-3 md:mt-4 px-2">
                <p class="font-headline italic text-xs md:text-sm text-gray-800">Mysterious</p>
                <p class="font-body text-[8px] md:text-[10px] text-gray-500 mt-1">"Embrace the unknown"</p>
                <div class="mt-2 h-px w-full bg-gray-200"></div>
                <p class="font-label text-[6px] md:text-[8px] uppercase tracking-wider text-primary mt-2">#enigmatic</p>
            </div>
        </div>
    </div>

    <!-- Polaroid 3 - Bottom Left -->
    <div class="absolute bottom-4 left-4 md:bottom-12 md:left-12 w-40 md:w-56 rotate-[8deg] transition-all duration-500 hover:rotate-0 hover:scale-110 hover:shadow-2xl hover:z-50 group cursor-pointer" style="z-index: 10;">
        <div class="bg-white p-2 pb-8 md:p-3 md:pb-12 shadow-xl rounded-sm">
            <img src="https://picsum.photos/id/26/400/400" alt="Urban exploration" class="w-full h-32 md:h-48 object-cover grayscale group-hover:grayscale-0 transition-all duration-500">
            <div class="mt-3 md:mt-4 px-2">
                <p class="font-headline italic text-xs md:text-sm text-gray-800">Rebellious</p>
                <p class="font-body text-[8px] md:text-[10px] text-gray-500 mt-1">"Break the rules"</p>
                <div class="mt-2 h-px w-full bg-gray-200"></div>
                <p class="font-label text-[6px] md:text-[8px] uppercase tracking-wider text-primary mt-2">#rebel</p>
            </div>
        </div>
    </div>

    <!-- Polaroid 4 - Bottom Right -->
    <div class="absolute bottom-4 right-4 md:bottom-12 md:right-12 w-40 md:w-56 rotate-[-8deg] transition-all duration-500 hover:rotate-0 hover:scale-110 hover:shadow-2xl hover:z-50 group cursor-pointer" style="z-index: 10;">
