                            <textarea class="w-full bg-transparent border-none p-0 font-headline italic text-xl md:text-2xl text-on-surface placeholder:text-outline-variant focus:ring-0 resize-none" placeholder="Describe the requirement..." rows="3"></textarea>
                        </div>
                        <button class="w-full bg-primary text-on-primary py-4 md:py-6 font-label uppercase tracking-[0.2em] text-[10px] md:text-sm hover:bg-primary-dim transition-all duration-500" style="font-family:'Cinzel',serif;">Transmit Inquiry</button>
                    </form>
                </div>
            </div>
        </section>

    </main>

    <footer class="w-full py-16 md:py-20 px-6 md:px-12 bg-[#050503] bg-gradient-to-t from-[#050503] to-transparent">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end w-full border-t border-[#c9a84c]/10 pt-12 max-w-screen-2xl mx-auto gap-8">
            <div class="space-y-4 md:space-y-6">
                <div style="font-family:'Cinzel',serif;" class="text-base text-[#c9a84c]">chunkz.mp4</div>
                <div class="font-mono text-[8px] md:text-[10px] uppercase tracking-[0.2em] text-[#5a4a28]">© 2026 All Rights Reserved.</div>
            </div>
            <div class="flex flex-wrap gap-6 md:gap-12">
                <a class="font-mono text-[8px] md:text-[10px] uppercase tracking-[0.2em] text-[#5a4a28] hover:text-[#c9a84c] transition-colors duration-300" href="#">Manifesto</a>
                <a class="font-mono text-[8px] md:text-[10px] uppercase tracking-[0.2em] text-[#5a4a28] hover:text-[#c9a84c] transition-colors duration-300" href="#">Source Protocol</a>
                <a class="font-mono text-[8px] md:text-[10px] uppercase tracking-[0.2em] text-[#5a4a28] hover:text-[#c9a84c] transition-colors duration-300" href="#">Neural Link</a>
            </div>
        </div>
    </footer>

    <!-- ========== SCRIPTS ========== -->
    <script>
        gsap.registerPlugin(ScrollTrigger);

        // ===== CLOUD PARTING ANIMATION WITH IMAGES =====
        const heroSection = document.getElementById('hero');
        const cloudBack = document.querySelector('.cloud-layer-back');
        const cloudMid = document.querySelector('.cloud-layer-mid');
        const cloudFront = document.querySelector('.cloud-layer-front');
        const allClouds = document.querySelectorAll('.cloud-img');

        // Store original X positions
        allClouds.forEach((cloud, index) => {
            cloud.dataset.originalX = index % 2 === 0 ? '-50' : '50';
        });

        ScrollTrigger.create({
            trigger: heroSection,
            start: "top top",
            end: "bottom top",
            scrub: 1.2,
            onUpdate: (self) => {
                const progress = self.progress;
               gsap.set(cloudBack, { x: -progress * 300 });
               gsap.set(cloudMid, { x: progress * 500 });
               gsap.set(cloudFront, { x: progress * 800 });
            }
        });

        // Hero content entrance
        gsap.from("#hero-content", {
            opacity: 0,
            y: 40,
            duration: 1.4,
            ease: "power3.out",
            delay: 0.3
        });

        // Section reveals
        gsap.utils.toArray('.reveal-section').forEach(section => {
            gsap.to(section, {
                scrollTrigger: {
                    trigger: section,
                    start: "top 85%",
                    toggleActions: "play none none reverse"
                },
                opacity: 1,
                y: 0,
                duration: 0.9,
                ease: "power2.out"
            });
        });

    </script>

    <script>
    gsap.registerPlugin(ScrollTrigger);

    const zoomWrap = document.getElementById('zoom-hero-wrap');
    const zoomQuote = document.getElementById('zoom-quote');
    const zoomFloaters = document.getElementById('zoom-floaters');

    document.querySelectorAll('#zoom-section video').forEach(v => v.play().catch(() => {}));

    ScrollTrigger.create({
        trigger: '#zoom-section',
        start: 'top top',
        end: '+=250%',
        pin: true,
        pinSpacing: true,
        scrub: 1.2,
        onUpdate: (self) => {
            const p = self.progress;
            const scale = 0.28 + p * 0.72;
            const rot = -2 * (1 - p);
            const radius = 8 * (1 - p);
            zoomWrap.style.transform = `scale(${scale}) rotate(${rot}deg)`;
            zoomWrap.style.borderRadius = radius + 'px';
            const fade = Math.max(0, 1 - p * 2.5);
            zoomFloaters.style.opacity = fade;
            zoomQuote.style.opacity = fade;
        }
    });
    </script>

    <!-- Video autoplay -->
    <script>
        const scrollVideo = document.getElementById('scrollVideo');
        if (scrollVideo) {
            scrollVideo.play().catch(() => {
                document.addEventListener('click', () => scrollVideo.play(), { once: true });
            });
        }
    </script>

    <!-- 3D Card Script -->
    <script>
        const imageGallery = [
            "https://lh3.googleusercontent.com/aida-public/AB6AXuDOG4E2n42SLSozKgvC6JmCM0HmTA4ZCRd1fyB4QukuBUqwRTh2kni_eL5lq6orZdnRSMLh7c8Uz8J44on0-sKi5d9qsuIRg0BnK_2tj3clzXwVs_qNpGKIDODWpOIESm8dFwx7m3ofbzGpXl1dQyzJJlV7vRmJp2sQk2f_EydHTbjvuC4K2BLnqGC41KiLQPWDKNcMW3SeyOPlFu08GRyLzQQbIZNA35uBmPEACI8yXOJ_U65fR4GJhXR4tm0gye61nqLmUpVhBUU",
            "https://lh3.googleusercontent.com/aida-public/AB6AXuDbHk_xO1moN1-8LT8Zyx6B6OG2FMIU5t8q2XzC0AOLmxQMZnijQAzece4bvnsN2TktzMm97q1_eMMO0nA-7GHD3f9UXNB663hKqySyaNIolLDp7QzDY9vr5mV7gYQedLzFVNQmh_frxWCqMaEdlOad9loomUenGIIp68puyr2iFP8D4n1p3Gl1QseNuOuIsPuIRam_qc07gcBiiG_nc45bCAWq73qIr2MI_VZD_c9DbuSWv-_kk6dyegqTEtANpYCTbg-H9Jsnw_Q",
            "https://lh3.googleusercontent.com/aida-public/AB6AXuB1UclDfMCvafgTS2qLlpgqGelPEG0pgIRnXOmfCLaiLeoXZrtinolC7P79ApKkbFpLwNAd99HryFxRGGUkGjpgfjIWAspyOjC1GkvlXs7K7rD-Lw_8i5J5cbjPLep5PvUCWjQ3XMC0wzGYrTF7CWhruttdnAbG_kLDOXElZcpY-e0mrXblggHgObyi5KvrPXoXizpq4vFhohcGfZdJN2-2EEHI6NMKdkExC7zQAEBXnzkr8lv1cZ5cOiY51mBk-glvCE-wrrKgoX4",
            "https://lh3.googleusercontent.com/aida-public/AB6AXuAN3Oav5XRtBF-rKl1ES-Aih7oKbJeI-xkviAK-h8u9oJ180BbxPt2MhmzrSQEU9yMZszzjoKgBzkpdKdTxogUkHKgNP-LpPz1Ped97hjgMU7glv3x46FMVCZBlefR5N3VVMc0EuGzm1Lpx3fRruMeZ2Kyh5BFUERXfDehq32zww5sZDQRE3H5PrHqS7ZwThNw5EhbeodMT1cuu_lXAzoa-33mbqCsGN5E5I8eVpk26KnIMyUQOKoorVq37zQqaD6Zd-5X_GfmqrsQ",
            "https://lh3.googleusercontent.com/aida-public/AB6AXuDOKRx1zBNEFD7K177CbXwCE88kInB0jvsaoCIoCod800COEmlpKwgl9SCSv2oPLFBJtmS_JbT4xqMmRbmkGi_c2Yq9o3eJhDTA7s395a3d0vuhsq-Wu09q9stc7eHDMHg9bjmGk38C9AW_2nX8a9ecqY9zLTPUyEZqIM1k6ZCrJXKMOy22dIxV-0ZgcMTABI8_TnL88Tt4qwQRaTVbZYzbZAmda2e3NqdI9D1DrvnlJhNDGVFlIzB62UUkBwZveum5ywPZeEdQpLM"
        ];

        const metricsCycle = [
            { label: "Annual Reach", value: "3M+", desc: "Generated views in the past year through strategic enhancement and neural-engagement editing." },
            { label: "Engagement Rate", value: "42%", desc: "Average audience retention across all platforms — above industry benchmark by 18%." },
            { label: "Projects Delivered", value: "87", desc: "End-to-end content transformations for creators, brands, and digital architects." },
            { label: "Virality Index", value: "2.4x", desc: "Organic share multiplier effect from biomechanically optimized content sequences." },
            { label: "Neural Resonance", value: "94%", desc: "Positive sentiment analysis across cognitive mapping of audience reactions." }
        ];

        let currentIndex = 0;
        const mainImg = document.getElementById('mainVisual');
        const metricLabel = document.getElementById('metric-label');
        const metricValue = document.getElementById('metric-value');
        const metricDesc = document.getElementById('metric-description');
        let isAnimating = false;

        // Preload images
        imageGallery.forEach(url => { const img = new Image(); img.src = url; });

        // Seed the back stack cards with next images
        const stackCards = document.querySelectorAll('.stack-card');
        stackCards[0].querySelector('img').src = imageGallery[1];
        stackCards[1].querySelector('img').src = imageGallery[2];

        const photoFront = document.getElementById('photoFront');
        photoFront.addEventListener('click', () => {
            if (isAnimating) return;
            isAnimating = true;

            // Animate front card: fly up and to the right, then snap to back
            gsap.to(photoFront, {
                x: 120, y: -80, rotation: 15, opacity: 0, scale: 0.85,
                duration: 0.45, ease: "power2.in",
                onComplete: () => {
                    currentIndex = (currentIndex + 1) % imageGallery.length;
                    const metric = metricsCycle[currentIndex % metricsCycle.length];

                    // Update front card image
                    mainImg.src = imageGallery[currentIndex];

                    // Shift stack images forward
                    stackCards[0].querySelector('img').src = imageGallery[(currentIndex + 1) % imageGallery.length];
                    stackCards[1].querySelector('img').src = imageGallery[(currentIndex + 2) % imageGallery.length];

                    // Reset front card off-screen below, then animate in
                    gsap.set(photoFront, { x: 0, y: 60, rotation: -2, opacity: 0, scale: 0.9 });
                    gsap.to(photoFront, {
                        y: 0, opacity: 1, scale: 1,
                        duration: 0.4, ease: "power2.out",
                        onComplete: () => { isAnimating = false; }
                    });

                    // Update metrics
                    gsap.to([metricLabel, metricValue, metricDesc], {
                        opacity: 0, y: -8, duration: 0.2,
                        onComplete: () => {
                            metricLabel.innerText = metric.label;
                            metricValue.innerText = metric.value;
                            metricDesc.innerText = metric.desc;
                            gsap.to([metricLabel, metricValue, metricDesc], { opacity: 1, y: 0, duration: 0.3 });
                        }
                    });
                }
            });
        });
    </script>

</body>
</html>
