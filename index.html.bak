<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "background": "#0a0a0a",
                        "on-background": "#f5e6c8",
                        "primary": "#c9a84c",
                        "primary-dim": "#a8893c",
                        "primary-container": "#3a2a0a",
                        "on-primary": "#1a0a00",
                        "on-primary-container": "#e8c87a",
                        "secondary": "#8b1a1a",
                        "secondary-container": "#3a0808",
                        "on-secondary": "#ffd4d4",
                        "surface": "#0a0a0a",
                        "surface-container": "#141008",
                        "surface-container-low": "#0f0c06",
                        "surface-container-high": "#1e1608",
                        "surface-container-highest": "#282010",
                        "surface-container-lowest": "#050503",
                        "surface-bright": "#2a2010",
                        "surface-variant": "#1e1608",
                        "on-surface": "#f5e6c8",
                        "on-surface-variant": "#b8a47a",
                        "outline": "#5a4a28",
                        "outline-variant": "#3a2a10",
                        "error": "#ff6b6b",
                        "tertiary": "#d4af37",
                    },
                    borderRadius: {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    fontFamily: {
                        "headline": ["Newsreader", "serif"],
                        "body": ["Manrope", "sans-serif"],
                        "label": ["Ade-Display", "monospace"]
                    }
                }
            }
        }
    </script>
    <style>
        @font-face {
            font-family: 'Ade-Display';
            src: url('/assets/fonts/Ade-Display.otf') format('opentype');
        }
        @font-face {
            font-family: 'Amient';
            src: url('/assets/fonts/amient-regular-trial.otf') format('opentype');
        }
        @import url('https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Manrope:wght@200..800&family=Cinzel:wght@400..900&display=swap');

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        }

        :root {
            --gold: #c9a84c;
            --gold-light: #e8c87a;
            --gold-pale: #f5e6c8;
            --crimson: #8b1a1a;
            --crimson-bright: #c0392b;
            --crimson-deep: #4a0808;
            --bg: #0a0a0a;
        }

        * { box-sizing: border-box; }

        body {
            background-color: var(--bg);
            color: var(--gold-pale);
            font-family: 'Manrope', sans-serif;
            overflow-x: hidden;
        }

        /* ====== HERO ====== */
        #hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        /* Embroidered wallpaper background */
        #hero-bg {
            position: absolute;
            inset: 0;
            z-index: 0;
            overflow: hidden;
        }

        .hero-vignette {
            position: absolute;
            inset: 0;
            z-index: 1;
        }

        .hero-bottom-fade {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 40%;
            z-index: 2;
        }

        /* Hero content */
        #hero-content {
            position: relative;
            z-index: 10;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .hero-eyebrow {
            font-family: 'Cinzel', serif;
            font-size: 0.65rem;
            letter-spacing: 0.35em;
            text-transform: uppercase;
            color: var(--gold);
            opacity: 0.9;
            margin-bottom: 1.5rem;
        }

        .hero-title {
            font-family: 'Amient', serif;
            font-size: clamp(5rem, 16vw, 14rem);
            font-weight: 700;
            line-height: 0.88;
            background: linear-gradient(160deg, #f5e6c8 0%, #e8c87a 30%, #c9a84c 60%, #8b6914 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -0.02em;
            filter: drop-shadow(0 0 40px rgba(201,168,76,0.25));
            margin-bottom: 1.5rem;
        }

        .hero-divider {
            width: 5rem;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
            margin: 0 auto 1.5rem;
        }

        .hero-subtitle {
            font-family: 'Manrope', sans-serif;
            font-size: clamp(0.85rem, 2vw, 1.1rem);
            color: rgba(232, 200, 122, 0.7);
            max-width: 38rem;
            line-height: 1.8;
            font-weight: 300;
            letter-spacing: 0.02em;
        }

        /* ====== CLOUD ANIMATION ====== */
        /* Cloud Layer Styles */
        #cloud-curtain {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 60%;
            z-index: 20;
            pointer-events: none;
            overflow: hidden;
        }

        .cloud-layer {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            display: flex;
            justify-content: space-around;
            gap: -20px;
        }

        .cloud-layer-back {
            bottom: -20px;
            z-index: 1;
        }

        .cloud-layer-mid {
            bottom: -10px;
            z-index: 2;
        }

        .cloud-layer-front {
            bottom: 0;
            z-index: 3;
        }

        .cloud-img {
            width: 200px;
            height: auto;
            opacity: 0.85;
            gap: -10px;
            filter: drop-shadow(0 0 10px rgba(0,0,0,0.5));
            animation: floatCloud 6s ease-in-out infinite;
        }

        /* Different sizes for depth */
        .cloud-layer-back .cloud-img { width: 400px; opacity: 0.9; }
        .cloud-layer-mid .cloud-img { width: 1000px; opacity: 0.9; }
        .cloud-layer-front .cloud-img { width: 600px; opacity: 0.95; }

        @keyframes floatCloud {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        /* Different animation delays */
        .cloud-layer-back .cloud-img:nth-child(2) { animation-delay: 2s; }
        .cloud-layer-back .cloud-img:nth-child(3) { animation-delay: 4s; }
        .cloud-layer-mid .cloud-img:nth-child(2) { animation-delay: 1s; }
        .cloud-layer-mid .cloud-img:nth-child(3) { animation-delay: 3s; }
        .cloud-layer-front .cloud-img:nth-child(2) { animation-delay: 2.5s; }

        /* ====== SCROLLBAR ====== */
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: #0a0a0a; }
        ::-webkit-scrollbar-thumb { background: var(--crimson-deep); }
        ::-webkit-scrollbar-thumb:hover { background: var(--gold); }

        /* ====== CARD 3D ====== */
        .card-3d-container {
            perspective: 1200px;
            transform-style: preserve-3d;
        }

        /* ====== POLAROID STACK ====== */
        .photo-card {
            position: absolute;
            inset: 0;
            background: #f5f0e8;
            padding: 16px 16px 64px 16px;
            border-radius: 4px;
            width: 500px;
            height: 600px;
            margin-bottom: 50px;
            box-shadow:
                0 4px 6px rgba(0,0,0,0.4),
                0 10px 30px rgba(0,0,0,0.5),
                0 20px 60px rgba(0,0,0,0.3),
                inset 0 1px 0 rgba(255,255,255,0.6);
        }
        .photo-card img { border-radius: 2px; display: block; }
        .stack-card { filter: brightness(0.75); }

        /* ====== ZOOM SECTION ====== */
        #zoom-section { height: 100vh; }
        .zoom-float {
            position: absolute;
            overflow: hidden;
            border-radius: 8px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.7);
        }
        #zoom-hero-wrap {
            transform: scale(0.28) rotate(-2deg);
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 8px 40px rgba(0,0,0,0.8);
        }

        /* ====== IMAGE GALLERY ====== */
        .image-transition-enter {
            animation: imagePop 0.5s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }
        @keyframes imagePop {
            0% { opacity: 0; transform: scale(0.92) rotateX(-5deg); filter: blur(2px); }
            100% { opacity: 1; transform: scale(1) rotateX(0deg); filter: blur(0); }
        }

        /* ====== BTN ====== */
        .btn-ripple {
            position: relative;
            overflow: hidden;
        }
        .btn-ripple::after {
            content: '';
            position: absolute;
            top: 50%; left: 50%;
            width: 0; height: 0;
            border-radius: 50%;
            background: rgba(201,168,76,0.25);
            transform: translate(-50%, -50%);
            transition: width 0.5s, height 0.5s;
        }
        .btn-ripple:active::after { width: 300px; height: 300px; }

        /* ====== GOLD SHIMMER ====== */
        @keyframes goldShimmer {
            0% { background-position: -200% center; }
            100% { background-position: 200% center; }
        }
        .gold-shimmer {
            background: linear-gradient(90deg, var(--gold) 0%, #fff8e1 45%, var(--gold) 55%, #8b6914 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: goldShimmer 4s linear infinite;
        }

        /* ====== ORNAMENTAL BORDER ====== */
        .ornate-border {
            border: 1px solid rgba(201,168,76,0.2);
            box-shadow: inset 0 0 30px rgba(139,26,26,0.05), 0 0 30px rgba(139,26,26,0.05);
        }

        /* ====== NEURAL GRID (crimson/gold) ====== */
        .neural-grid {
            background-image: 
                linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(139,26,26,0.04) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        /* ====== NAV ====== */
        nav {
            background: rgba(10,8,4,0.85);
            border-bottom: 1px solid rgba(201,168,76,0.08);
        }

        /* ====== SECTION REVEALS ====== */
        .reveal-section {
            opacity: 0;
            transform: translateY(30px);
        }
    </style>
</head>
<body class="bg-background text-on-background selection:bg-primary selection:text-on-primary">

    <!-- TopNavBar -->
    <nav class="sticky top-0 w-full z-50 backdrop-blur-xl shadow-2xl shadow-black/80">
        <div class="flex justify-between items-center px-6 md:px-12 py-4 md:py-6 max-w-screen-2xl mx-auto">
            <div style="font-family:'Cinzel',serif;" class="text-base md:text-lg tracking-[0.15em] text-[#c9a84c]">Portfolio.mp4</div>
            <div class="hidden lg:flex gap-8 xl:gap-12 items-center">
                <a class="text-[#c9a84c] border-b border-[#c9a84c]/40 pb-0.5 font-label text-[10px] xl:text-xs uppercase tracking-widest transition-colors duration-500" href="#work">Selected Work</a>
                <a class="text-[#b8a47a]/60 font-light font-label text-[10px] xl:text-xs uppercase tracking-widest hover:text-[#c9a84c] transition-colors duration-500" href="#authority">Testimonials</a>
                <a class="text-[#b8a47a]/60 font-light font-label text-[10px] xl:text-xs uppercase tracking-widest hover:text-[#c9a84c] transition-colors duration-500" href="#philosophy">Doctrine</a>
            </div>
            <button class="bg-[#c9a84c] text-[#1a0a00] px-4 md:px-6 py-2 text-[10px] md:text-xs font-label uppercase tracking-widest hover:bg-[#e8c87a] transition-colors duration-300" style="font-family:'Cinzel',serif;">
                Initialize <span class="hidden sm:inline">Contact</span>
            </button>
        </div>
    </nav>

    <main>

        <!-- ========== HERO SECTION ========== -->
        <section id="hero">

            <!-- Embroidered Wallpaper Background -->
            <div id="hero-bg">
              <!--     <img style="filter: blur(7px)" src="/assets/hero-img.png" />  -->
              <div class="hero-vignette"></div>
                <div class="hero-bottom-fade"></div>
            </div>

            <!-- Hero Content -->
            <div id="hero-content" class="px-6">
                <div class="hero-eyebrow">chunkz.mp4 &nbsp;·&nbsp; 4 Years Depth</div>
                <h1 class="hero-title">MP4</h1>
                <div class="hero-divider"></div>
                <p class="hero-subtitle">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor ad minim veniam, quis nostrud e

                </p>
            </div>

            <!-- Cloud Curtain with PNG Images -->
<!-- Cloud Curtain with PNG Images -->
<div id="cloud-curtain">
    <!-- Layer 1 - Back clouds (furthest, moves slowest, darkest/most transparent) -->
    <div class="cloud-layer cloud-layer-back">
        <img src="/assets/bubble-cloud.png" class="cloud-img" alt="cloud">
        <img src="/assets/bubble-cloud.png" class="cloud-img" alt="cloud">
        <img src="/assets/cloud.png" class="cloud-img" alt="cloud">
        <img src="/assets/cloud.png" class="cloud-img" alt="cloud">
        <img src="/assets/cloud.png" class="cloud-img" alt="cloud">
    </div>

    <!-- Layer 2 - Mid clouds (middle layer, medium movement) -->
    <div class="cloud-layer cloud-layer-mid">
        <img src="/assets/bubble-cloud.png" class="cloud-img" alt="cloud">
        <img src="/assets/bubble-cloud.png" class="cloud-img" alt="cloud">
        <img src="/assets/bubble-cloud.png" class="cloud-img" alt="cloud">
        <img src="/assets/bubble-cloud.png" class="cloud-img" alt="cloud">
    </div>

    <!-- Layer 3 - Front clouds (closest, moves fastest, most opaque) -->
    <div class="cloud-layer cloud-layer-front">
        <img src="assets/small-single-cloud.png" class="cloud-img" alt="cloud">
        <img src="assets/small-single-cloud.png" class="cloud-img" alt="cloud">
        <img src="assets/small-single-cloud.png" class="cloud-img" alt="cloud">
        <img src="assets/small-single-cloud.png" class="cloud-img" alt="cloud">
        <img src="/assets/bubble-cloud.png" class="cloud-img" alt="cloud">
        <img src="/assets/bubble-cloud.png" class="cloud-img" alt="cloud">
    </div>
</div>
            <!-- Scroll indicator -->
            <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center gap-2">
                <span style="font-family:'Cinzel',serif;" class="text-[8px] uppercase tracking-[0.3em] text-[#c9a84c]/50">scroll</span>
                <div class="w-px h-10 bg-gradient-to-b from-[#c9a84c]/40 to-transparent"></div>
            </div>
        </section>

        <!-- Metrics Section -->
        <section class="bg-surface-container-lowest py-20 md:py-32 px-6 md:px-12 reveal-section" id="metrics">
            <div class="max-w-screen-2xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 md:gap-24 items-center">
                <div class="space-y-8 md:space-y-12">
                    <h2 class="font-headline text-4xl md:text-5xl italic text-on-surface tracking-tight" style="font-family:'Cinzel',serif;">Quantitative Validation</h2>
                    <div class="space-y-2" id="metric-data">
                        <div class="font-label text-[10px] md:text-xs text-primary tracking-[0.2em] uppercase" id="metric-label">Annual Reach</div>
                        <div class="text-7xl md:text-8xl font-headline italic text-primary gold-shimmer" id="metric-value" style="font-family:'Cinzel',serif;">3M+</div>
                        <p class="font-body text-sm md:text-base text-on-surface-variant max-w-sm" id="metric-description">Generated views in the past year through strategic enhancement and neural-engagement editing.</p>
                    </div>
                    <!-- no button -->
                </div>
                <div class="aspect-square flex items-center justify-center md:p-12 relative rounded-xl card-3d-container">
                    <div class="absolute inset-0 bg-gradient-radial from-primary/5 to-transparent pointer-events-none"></div>
                    <div id="photo-stack" class="relative w-72 h-80 cursor-pointer mx-auto" style="perspective: 1000px;">
